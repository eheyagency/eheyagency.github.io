            <path d="M29.3113 17.3118C27.5815 17.6161 26.0467 18.5711 25.0311 19.9514C24.0155 21.3317 23.6031 23.0432 23.9011 24.7204C24.1991 26.3976 25.1867 27.9143 26.6465 28.9092C28.1063 29.9041 29.9312 30.2814 31.6806 29.9404C33.43 29.5994 34.9064 28.5713 35.8073 27.1044C34.9268 28.0893 33.8018 28.8427 32.5407 29.2814C31.2796 29.7201 29.9212 29.8265 28.6173 29.5914C27.3134 29.3563 26.1088 28.7876 25.1312 27.9413C24.1536 27.095 23.4445 25.9993 23.0812 24.8044C22.7179 23.6095 22.7154 22.3518 23.0734 21.1554C23.4314 19.959 24.1364 18.8606 25.1086 18.0104C26.0808 17.1602 27.283 16.5904 28.5813 16.3514C28.8273 16.3084 29.0753 16.2854 29.3233 16.2824V17.3118H29.3113Z" fill="white"/>
