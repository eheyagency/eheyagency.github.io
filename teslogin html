        </svg>
        Masuk dengan TikTok
    </button>

    <p class="sandbox-label">🧪 MODE SANDBOX — Hanya untuk uji coba pengembang</p>
</div>

<!-- LAYAR PERSETUJUAN -->
<div id="layar-izin" class="login-box izin-box hidden">
    <h3 style="color:#fff; margin-bottom:10px;">Otorisasi Aplikasi</h3>
    <p style="color:#aaa; font-size:14px;">
        <strong style="color:#fff;">EHEY AGENCY Sandbox</strong><br>
        meminta izin mengakses informasi dasar akun Anda
    </p>
    <p style="color:#ffd700; font-size:13px; margin-top:15px;">@jemzlamato</p>
    <button class="btn-izinkan" onclick="prosesIzin()">Izinkan</button>
    <a href="#" class="kembali-link" onclick="kembaliAwal(event)">← Batal</a>
</div>

<!-- HALAMAN SUKSES -->
<div id="halaman-sukses" class="login-box hidden">
    <div class="sukses-icon">✅</div>
    <h2 style="color:#2bde73; margin-bottom:10px;">Berhasil Masuk!</h2>
    <p style="color:#999; font-size:14px;">Selamat datang di EHEY AGENCY</p>
    
    <div class="data-box">
        <strong>Status:</strong> Berhasil terhubung ke Sandbox<br>
        <strong>Akun:</strong> @jemzlamato<br>
        <strong>Role:</strong> Penguji Sandbox<br>
        <strong>Kode Auth:</strong> clt.sandbox.code.ehey777xyz
    </div>
    
    <a href="#" class="kembali-link" onclick="kembaliAwal(event)">← Keluar</a>
</div>

<script>
function mulaiLogin() {
    document.getElementById('halaman-awal').classList.add('hidden');
    document.getElementById('layar-izin').classList.remove('hidden');
    
    // Nanti ganti baris di atas dengan kode ini untuk koneksi sungguhan:
    // window.location.href = "https://www.tiktok.com/auth/authorize/?client_key=GANTI_DISINI&scope=user.info.basic&redirect_uri=GANTI_REDIRECT_URI";
}

function prosesIzin() {
    document.getElementById('layar-izin').classList.add('hidden');
    document.getElementById('halaman-sukses').classList.remove('hidden');
}

function kembaliAwal(e) {
    e.preventDefault();
    document.getElementById('halaman-sukses').classList.add('hidden');
    document.getElementById('layar-izin').classList.add('hidden');
    document.getElementById('halaman-awal').classList.remove('hidden');
}
<script>
function mulaiLogin() {
    // GANTI baris di bawah ini:
    const CLIENT_KEY = "SALIN-DARI-TIKTOK-DEVELOPER";
    const REDIRECT_URI = encodeURIComponent("https://nama-lovable.lovable.app/auth/callback");
    const SCOPE = "user.info.basic";
    
    window.location.href = `https://www.tiktok.com/auth/authorize/?client_key=${CLIENT_KEY}&scope=${SCOPE}&redirect_uri=${REDIRECT_URI}`;
}

</script>

</body>
</html>
