<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EHEY AGENCY — Login Sandbox</title>
    <link rel="icon" href="ehey.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #000000 0%, #1a1a0f 50%, #0f0f00 100%);
            padding: 20px;
        }

        /* Kotak Utama */
        .login-box {
            background: #000;
            padding: 40px 30px;
            border-radius: 16px;
            border: 1px solid rgba(255, 215, 0, 0.25);
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.1);
            text-align: center;
            max-width: 380px;
            width: 100%;
        }

        .logo {
            width: 70px;
            height: 70px;
            margin-bottom: 15px;
        }

        .login-box h2 {
            color: #fff;
            font-size: 22px;
            margin-bottom: 8px;
        }

        .deskripsi {
            color: #999;
            font-size: 14px;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        /* ========== TOMBOL LOGIN TIKTOK — SAMA PERSIS RESMI ========== */
        .btn-tiktok {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 13px 24px;
            background: #000;
            color: #fff;
            border: 1px solid #2f2f2f;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            text-decoration: none;
        }

        .btn-tiktok:hover {
            background: #1c1c1c;
            border-color: #444;
            transform: translateY(-1px);
        }

        .btn-tiktok svg {
            width: 22px;
            height: 22px;
        }
        /* ============================================================ */

        .sandbox-label {
            display: inline-block;
            margin-top: 25px;
            padding: 6px 14px;
            background: rgba(255, 215, 0, 0.15);
            color: #ffd700;
            font-size: 12px;
            border-radius: 20px;
        }

        .hidden { display: none !important; }

        /* Layar Izin */
        .izin-box {
            border-top: 3px solid #fe2c55;
        }

        .btn-izinkan {
            width: 100%;
            padding: 12px;
            background: #fe2c55;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
        }

        .btn-izinkan:hover {
            background: #e6274d;
        }

        /* Halaman Sukses */
        .sukses-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }

        .data-box {
            background: #121212;
            border: 1px solid #2a2a2a;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            font-family: monospace;
            font-size: 13px;
            text-align: left;
            color: #ccc;
            word-break: break-all;
        }

        .kembali-link {
            display: inline-block;
            margin-top: 20px;
            color: #999;
            font-size: 14px;
            text-decoration: none;
        }

        .kembali-link:hover {
            color: #fff;
        }
    </style>
</head>
<body>

<!-- HALAMAN AWAL — TOMBOL LOGIN -->
<div id="halaman-awal" class="login-box">
    <img src="ehey.png" alt="EHEY AGENCY" class="logo" onerror="this.style.display='none'">
    <h2>EHEY AGENCY</h2>
    <p class="deskripsi">Masuk menggunakan akun TikTok untuk mengakses daftar anggota.</p>

    <!-- TOMBOL LOGIN — SAMA PERSIS DENGAN ASLINYA -->
    <button class="btn-tiktok" onclick="mulaiLogin()">
